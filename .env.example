# Shared
NODE_ENV=development
AUTH_MODE=mock

# API
API_PORT=4000
DATABASE_URL=postgres://argus:argus@localhost:5432/argus
CORS_ORIGIN=http://localhost:3000
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
AWS_REGION=ap-southeast-1

# Web / BFF
NEXT_PUBLIC_AUTH_MODE=mock
ARGUS_API_URL=http://localhost:4000
MOCK_USER_ID=local-user
MOCK_USER_EMAIL=developer@argus.local
COGNITO_DOMAIN=
COGNITO_REDIRECT_URI=http://localhost:3000/api/auth/callback
COGNITO_LOGOUT_URI=http://localhost:3000/login

# Probe
ARGUS_ENV=development
ARGUS_CONTROL_PLANE_URL=http://localhost:4000
ARGUS_PROBE_ID=local-probe
ARGUS_REGION=local
ARGUS_TOKEN=replace-me
ARGUS_CONCURRENCY=4
ARGUS_ALLOW_PRIVATE_TARGETS=true
REDIS_URL=redis://localhost:6379
# Local only. In staging/production supply a private key through a secret reference.
PROBE_TOKEN_HMAC_KEY=local-development-hmac-key-not-for-production
SEED_DEV_PROBES=true
SCHEDULER_ENABLED=true
WORKER_METRICS_PORT=4001
