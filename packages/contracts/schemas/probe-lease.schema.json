{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argus.local/schemas/probe-lease.schema.json",
  "title": "ProbeLease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leaseId",
    "expiresAt",
    "targetRegion",
    "job"
  ],
  "properties": {
    "leaseId": {
      "type": "string",
      "format": "uuid"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetRegion": {
      "type": "string"
    },
    "job": {
      "$ref": "https://argus.local/schemas/probe-job.schema.json"
    }
  }
}
